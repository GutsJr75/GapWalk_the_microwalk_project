# Database
DATABASE_URL=postgresql://gapwalk:gapwalk_dev@localhost:5432/gapwalk
POSTGRES_PASSWORD=gapwalk_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.gapwalk.com
AUTH0_CLIENT_ID=your_backend_client_id
AUTH0_CLIENT_SECRET=your_backend_client_secret

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
ENABLE_WORKERS=true

# Tests
# By default Prisma connection is skipped when NODE_ENV=test.
# Set to true only for integration/e2e runs against a real DB.
PRISMA_CONNECT_IN_TEST=false

# Google Calendar (server-side refresh)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
