# Database
DATABASE_URL=postgresql://gapwalk:gapwalk_dev@localhost:5432/gapwalk
POSTGRES_PASSWORD=gapwalk_dev

# Redis
REDIS_URL=redis://localhost:6379

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional alternative to the three variables above:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
ENABLE_WORKERS=true
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_BLOCK_DURATION_MS=60000

# Tests
# By default Prisma connection is skipped when NODE_ENV=test.
# Set to true only for integration/e2e runs against a real DB.
PRISMA_CONNECT_IN_TEST=false

# Google Calendar (server-side refresh)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ──────────────────────────────────────────────────────────
# PRODUCTION NOTES:
# - Set NODE_ENV=production
# - Use a strong POSTGRES_PASSWORD (min 32 chars, random)
# - Set CORS_ORIGIN to your mobile app's production origin
# - Set SWAGGER_ENABLED=false unless actively debugging
# - Use SSL DATABASE_URL: postgresql://user:pass@host:5432/db?sslmode=require
# - Ensure REDIS_URL points to your production Redis (with TLS if hosted)
# - Rotate all secrets before production deployment
# ──────────────────────────────────────────────────────────
