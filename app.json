{
  "expo": {
    "newArchEnabled": true,
    "name": "GapWalk",
    "slug": "gapwalk",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gapwalk",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icons/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1.0.3",
      "bundleIdentifier": "com.gapwalk.app",
      "infoPlist": {
        "NSMotionUsageDescription": "GapWalk uses motion data to count your steps during walks.",
        "NSLocationWhenInUseUsageDescription": "GapWalk needs your location to track distance and show your walking route.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.gapwalk.app",
      "versionCode": 10105,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundColor": "#0b1220"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GapWalk to use your location to track walking distance."
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-sensors",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8dc70f8f-57e4-4ee4-9a0e-6a1d2977513a"
      }
    }
  }
}
