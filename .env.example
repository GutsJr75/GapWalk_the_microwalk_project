# Google Calendar (optional). Restart the app after changing.
# Create separate OAuth 2.0 clients in Google Cloud:
# - Web client for browser auth
# - Android client for package `com.gapwalk.app` + your signing SHA-1
# - iOS client for bundle ID `com.gapwalk.app`
# Do not reuse the web client ID for iOS or Android.
# Native builds in this app return to `com.gapwalk.app:/oauthredirect`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Google Maps API key for Android map rendering (required for Walking map screen).
# Use the same key value for both variables.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Auth0 (required for app login gate). Restart the app after changing.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_mobile_client_id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.gapwalk.com

# Backend API URL (required for research data sync).
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:3000
