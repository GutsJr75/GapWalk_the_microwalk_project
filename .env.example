# Google Calendar (optional). Restart the app after changing.
# Use one Google project consistently for Firebase and Calendar.
# - Web client for browser auth / token exchange
# - Android package `com.gapwalk.app` + signing SHA-1 registered in the same
#   project as `google-services.json`
# Do not create duplicate Android OAuth clients in a different Google project.
# Native builds in this app return to `com.gapwalk.app:/oauthredirect`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Google Maps API key for Android map rendering (required for Walking map screen).
# GOOGLE_MAPS_API_KEY is preferred for native builds; EXPO_PUBLIC_* is accepted as a fallback.
# Use the same key value for both variables when possible.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Authentication (required for app login gate). Restart the app after changing.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend API URL (required for research data sync).
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:3000
